# ============================================================
#  laravel-reports doc/demo – production environment
# ============================================================
#  Copy to .env and generate the key (install.sh does both):
#
#     cp .env.example .env
#     php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
#
#  The container is stateless: file sessions/cache, SQLite baked
#  into the image, logs on stderr.
# ============================================================

APP_NAME="Laravel Reports"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laravel-reports.private-net.ch

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr keeps the logs in `docker compose logs`; no volume needed.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite demo database, baked into the image by the Dockerfile.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@private-net.ch"
MAIL_FROM_NAME="${APP_NAME}"

# Chromium inside the image (symlinked by the Dockerfile).
LARAVEL_PDF_CHROME_BINARY=/usr/local/bin/chromium
