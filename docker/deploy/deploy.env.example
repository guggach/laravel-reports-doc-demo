# ============================================================
#  Deploy credentials (host only, never passed into the container)
# ============================================================
#  Only needed if the GHCR package is private. The public package
#  can be pulled anonymously, so leave GHCR_TOKEN empty in that case.
#  pull.sh sources this file; it is NOT used by compose.yml.
# ============================================================

GHCR_USER=guggach
GHCR_TOKEN=
